<Window x:Class="AutomationLauncher.App.StartupSequenceSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automation Launcher"
        Width="900"
        Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#0D1B2A"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <Image x:Name="BackgroundImage"
               Stretch="UniformToFill"
               Opacity="0.9" />

        <Border Background="#8C07111B" />

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="ApplicationTitleText"
                       HorizontalAlignment="Right"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Text="Automation Launcher" />

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="700">
                <TextBlock Text="Windows startup automation"
                           FontSize="20"
                           Foreground="#D7E4ED"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusText"
                           Margin="0,18,0,0"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="Preparing startup sequence..." />
                <TextBlock x:Name="SaveStatusText"
                           Margin="0,14,0,0"
                           FontSize="17"
                           Foreground="#F5A623"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Text="" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="ConfirmActionButton"
                        Width="160"
                        Height="42"
                        Margin="0,0,10,0"
                        Content="Confirm"
                        Background="#2E8B57"
                        Foreground="White"
                        BorderBrush="#2E8B57"
                        Visibility="Collapsed"
                        Click="Confirm_Click" />
                <Button x:Name="SaveNowButton"
                        Width="150"
                        Height="42"
                        Margin="0,0,10,0"
                        Content="Save now"
                        Background="#E07B00"
                        Foreground="White"
                        BorderBrush="#E07B00"
                        Visibility="Collapsed"
                        Click="SaveNow_Click" />
                <Button x:Name="SkipSaveButton"
                        Width="120"
                        Height="42"
                        Margin="0,0,10,0"
                        Content="Skip save"
                        Background="#5A5A5A"
                        Foreground="White"
                        BorderBrush="#5A5A5A"
                        Visibility="Collapsed"
                        Click="SkipSave_Click" />
                <Button x:Name="CancelActionButton"
                        Width="160"
                        Height="42"
                        Content="Cancel startup"
                        Background="#C44949"
                        Foreground="White"
                        BorderBrush="#C44949"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>