<Window x:Class="AutomationLauncher.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automation Launcher - About"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F7F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="18" Background="#0D1B2A" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="Automation Launcher"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="#D8E2EA"
                           Text="Production information for support, diagnostics and deployment verification." />
                <TextBlock Margin="0,8,0,0"
                           Foreground="#BFD4E2"
                           FontWeight="SemiBold"
                           Text="{Binding VersionLabel}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="16" Background="White" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Version" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Version}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" Margin="0,10,0,0" Text="Host name" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Text="{Binding HostName}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="Protected settings" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Text="{Binding ProtectedSettingsPath}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="Log directory" FontWeight="SemiBold" />
                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Text="{Binding LogDirectory}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="120"
                    Height="36"
                    Content="Close"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>