<Window x:Class="AutomationLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Automation Launcher - Tray Dashboard"
        Width="960"
        Height="720"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#F4F7F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#E2EAF0" />
            <Setter Property="Foreground" Value="#0D1B2A" />
            <Setter Property="BorderBrush" Value="#C5D3DE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D3E1EC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C0D3E0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1F567D" />
            <Setter Property="BorderBrush" Value="#1F567D" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="PositiveActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1E7D4C" />
            <Setter Property="BorderBrush" Value="#1E7D4C" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="DangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B23B3B" />
            <Setter Property="BorderBrush" Value="#B23B3B" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#90A4B0" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="560" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="460" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- Row 0: Header -->
        <Border Grid.ColumnSpan="3" Padding="18" Background="#0D1B2A" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="Automation Launcher" Foreground="White" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="The application works primarily from the tray icon. Use this dashboard for status, diagnostics and manual actions."
                           Foreground="#D8E2EA"
                           Margin="0,8,0,0" />
                <TextBlock Text="{Binding AppVersion, StringFormat=Version {0}}"
                           Foreground="#BFD4E2"
                           Margin="0,8,0,0"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- Row 1: Status Banner -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" CornerRadius="10" Height="52">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1B5E20" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HostControlStateDisplay, Mode=OneWay}" Value="Running">
                            <Setter Property="Background" Value="#0D47A1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HostControlStateDisplay, Mode=OneWay}" Value="Error">
                            <Setter Property="Background" Value="#B71C1C" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HostControlStateDisplay, Mode=OneWay}" Value="Stopping">
                            <Setter Property="Background" Value="#E65100" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="White">
                        <Run Text="● " />
                        <Run Text="{Binding HostControlStateDisplay, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#FFFFFFCC">
                        <Run Text="— " />
                        <Run Text="{Binding HostName}" />
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FFFFFFB0"
                           FontSize="13"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding StatusMessage}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="#FFFFFFCC" FontSize="12">
                        <Run Text="Session: " />
                        <Run Text="{Binding SessionTimeRemaining}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: Action Buttons -->
        <Border Grid.Row="2" Grid.Column="0" Margin="0,12,0,0" Padding="16" Background="White" CornerRadius="12">
            <StackPanel>
                <!-- Archive -->
                <TextBlock Text="ARCHIVE" Style="{StaticResource SectionLabelStyle}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Check TIA connection"
                            Style="{StaticResource PositiveActionButtonStyle}"
                            IsEnabled="{Binding CanUseProtectedActions}"
                            Command="{Binding CheckTiaConnectionCommand}" />
                    <Button Content="Create archive now"
                            Margin="0"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            IsEnabled="{Binding CanUseProtectedActions}"
                            Click="ArchiveNow_Click" />
                </StackPanel>

                <Border Height="1" Background="#E8EDF0" Margin="0,0,0,12" />

                <!-- Process control -->
                <TextBlock Text="PROCESS CONTROL" Style="{StaticResource SectionLabelStyle}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Run startup automation"
                            IsEnabled="{Binding CanRunStartupAutomationManually}"
                            Click="RunStartupAutomation_Click" />
                    <Button Content="Run managed apps"
                            IsEnabled="{Binding CanRunStartupAutomationManually}"
                            Click="RunManagedApplications_Click" />
                    <Button Content="Stop managed apps"
                            Margin="0"
                            Style="{StaticResource DangerActionButtonStyle}"
                            IsEnabled="{Binding CanStopManagedApplications}"
                            Click="StopManagedApplications_Click" />
                </StackPanel>

                <Border Height="1" Background="#E8EDF0" Margin="0,0,0,12" />

                <!-- Session -->
                <TextBlock Text="SESSION" Style="{StaticResource SectionLabelStyle}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Log in"
                            Style="{StaticResource PositiveActionButtonStyle}"
                            IsEnabled="{Binding CanLoginSession}"
                            Click="Login_Click" />
                    <Button Content="Log out"
                            Margin="0"
                            Style="{StaticResource DangerActionButtonStyle}"
                            IsEnabled="{Binding IsSessionAuthenticated}"
                            Command="{Binding LogoutSessionCommand}" />
                </StackPanel>

                <Border Height="1" Background="#E8EDF0" Margin="0,0,0,12" />

                <!-- Tools -->
                <TextBlock Text="TOOLS &amp; NAVIGATION" Style="{StaticResource SectionLabelStyle}" />
                <WrapPanel Margin="0,0,0,12">
                    <Button Content="Settings" Click="Settings_Click" />
                    <Button Content="About" Click="About_Click" />
                    <Button Content="Show full flow" Click="ShowFlow_Click" />
                    <Button Content="Control files folder"
                            IsEnabled="{Binding CanUseProtectedUtilities}"
                            Command="{Binding OpenControlFilesFolderCommand}" />
                    <Button Content="Log folder"
                            IsEnabled="{Binding CanUseProtectedUtilities}"
                            Command="{Binding OpenLogDirectoryCommand}" />
                    <Button Content="Autostart folder"
                            Margin="0"
                            IsEnabled="{Binding CanUseProtectedUtilities}"
                            Command="{Binding OpenStartupFolderCommand}" />
                </WrapPanel>

                <Border Height="1" Background="#E8EDF0" Margin="0,0,0,12" />

                <!-- Danger / Exit -->
                <Grid>
                    <Button HorizontalAlignment="Left"
                            Margin="0"
                            Content="Delete error marker"
                            Style="{StaticResource DangerActionButtonStyle}"
                            IsEnabled="{Binding HasErrorControlFile}"
                            Click="DeleteError_Click" />
                    <Button HorizontalAlignment="Right"
                            Width="80"
                            Margin="0"
                            Content="Exit"
                            Click="Exit_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 3: Runtime Status -->
        <Border Grid.Row="3" Grid.Column="0" Margin="0,12,0,0" Padding="16" Background="White" CornerRadius="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Runtime status" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <!-- Key status card (highlighted) -->
                    <Border Padding="12" Background="#EEF6FF" CornerRadius="8" BorderBrush="#B8D4F0" BorderThickness="1" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Host control state" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" FontWeight="Bold" Text="{Binding HostControlStateDisplay, Mode=OneWay}" />

                            <TextBlock Grid.Row="1" Text="Host name" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding HostName}" />

                            <TextBlock Grid.Row="2" Text="Selected runtime" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="{Binding SelectedRuntimeVersion}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" Text="TIA provider" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Text="{Binding SelectedProviderName}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <TextBlock Margin="0,0,0,4" Text="{Binding RuntimeDecisionMessage}" TextWrapping="Wrap" Foreground="#5B6A72" />
                    <TextBlock Margin="0,0,0,12" Text="{Binding SettingsStatusMessage}" TextWrapping="Wrap" Foreground="#5B6A72" />

                    <!-- Detail fields -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" MinWidth="360" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Application version" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding AppVersion}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Text="Configured project path" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding ExpectedProjectPath}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Text="Archive directory" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="{Binding ArchiveOutputDirectory}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3" Text="Detected process version" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Text="{Binding DetectedProcessVersion}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="4" Text="Assembly path" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Text="{Binding SelectedAssemblyPath}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="5" Text="Control files folder" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Text="{Binding ControlFilesFolderPath}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="6" Margin="0,10,0,0" Text="Control file paths" FontWeight="SemiBold" Foreground="#90A4B0" />

                        <TextBlock Grid.Row="7" Text="Run / Ready / Error" FontSize="11" Foreground="#90A4B0" Margin="0,6,0,0" />
                        <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,6,0,0">
                            <TextBlock Text="{Binding HostRunFilePath}" Foreground="#90A4B0" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HostReadyFilePath}" Foreground="#90A4B0" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding HostErrorFilePath}" Foreground="#90A4B0" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="8" Text="Start / Stop / March / Archok" FontSize="11" Foreground="#90A4B0" Margin="0,6,0,0" />
                        <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,6,0,0">
                            <TextBlock Text="{Binding HostStartFilePath}" Foreground="#90A4B0" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HostStopFilePath}" Foreground="#90A4B0" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding HostMarchFilePath}" Foreground="#90A4B0" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding HostArchOkFilePath}" Foreground="#90A4B0" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Row="2"
                      Grid.Column="1"
                      Grid.RowSpan="3"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      Background="#D0D7DE" />

        <!-- Right: Logs Panel (Row 2–4) -->
        <Border Grid.Row="2" Grid.Column="2" Grid.RowSpan="3" Margin="0,12,0,0" Padding="16" Background="White" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logs header with ERR/WRN badges -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Logs" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />

                    <Border Grid.Column="1" Margin="0,0,6,0" Padding="7,2" CornerRadius="10" VerticalAlignment="Center" Background="#FDECEA">
                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#B71C1C"
                                   Text="{Binding ErrorLogCount, StringFormat=ERR {0}}" />
                    </Border>

                    <Border Grid.Column="2" Margin="0,0,10,0" Padding="7,2" CornerRadius="10" VerticalAlignment="Center" Background="#FFF3E0">
                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#E65100"
                                   Text="{Binding WarnLogCount, StringFormat=WRN {0}}" />
                    </Border>

                    <TextBlock Grid.Column="3"
                               VerticalAlignment="Center"
                               Foreground="#5B6A72"
                               FontWeight="SemiBold"
                               Text="{Binding VisibleLogCount, StringFormat=Total: {0}}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Height="32"
                             Margin="0,0,10,0"
                             VerticalContentAlignment="Center"
                             FontSize="13"
                             Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="1"
                            Height="32"
                            Margin="0,0,10,0"
                            Padding="10,4"
                            Content="Clear"
                            IsEnabled="{Binding HasLogSearchText}"
                            Command="{Binding ClearLogSearchCommand}" />

                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="#5B6A72"
                               Text="Search logs" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Content="Only ERR/WRN"
                              VerticalAlignment="Center"
                              IsChecked="{Binding ShowErrorsAndWarningsOnly}" />

                    <CheckBox Grid.Column="1"
                              Content="Auto-scroll"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsLogAutoScrollEnabled}" />
                </Grid>

                <ListBox x:Name="LogsListBox"
                         Grid.Row="3"
                         Margin="0,12,0,8"
                         ItemsSource="{Binding FileLogs}"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.IsDeferredScrollingEnabled="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4"
                                    Padding="6,4"
                                    CornerRadius="6"
                                    Background="{Binding Background}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Level}"
                                               FontWeight="Bold"
                                               Foreground="{Binding Foreground}" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Message}"
                                               Foreground="{Binding Foreground}"
                                               TextWrapping="Wrap"
                                               FontFamily="Consolas" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="4"
                           Foreground="#5B6A72"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="11"
                           Text="{Binding LoadedLogFilePath, StringFormat=Loaded file: {0}}" />
            </Grid>
        </Border>

        <!-- Row 4: Footer -->
        <Grid Grid.Row="4" Grid.Column="0" Margin="0,14,0,0">
            <TextBlock Text="The main window stays outside the taskbar. Use the tray icon next to the clock for quick actions and settings."
                       Foreground="#5B6A72"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
