                                                <Button Height="34" Margin="0,10,0,0" Content="Remove" Command="{Binding RemoveSelectedPostControlFileScriptStepCommand}" />
                                                <Button Height="34" Margin="0,10,0,0" Content="Move up" Command="{Binding MovePostControlFileScriptStepUpCommand}" />
                                                <Button Height="34" Margin="0,10,0,0" Content="Move down" Command="{Binding MovePostControlFileScriptStepDownCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="4" Padding="14" Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCE3E8" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="120" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="180" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.ColumnSpan="2" Text="Selected step overrides and preview" FontSize="20" FontWeight="Bold" Foreground="#0D1B2A" />

                                            <DataGrid Grid.Row="1"
                                                      Grid.Column="0"
                                                      Margin="0,14,16,0"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      HeadersVisibility="Column"
                                                      Height="110"
                                                      ItemsSource="{Binding ActiveControlFileScriptStep.ParameterOverrides}"
                                                      SelectedItem="{Binding SelectedActiveControlFileParameterOverride}"
                                                      GridLinesVisibility="Horizontal"
                                                      SelectionMode="Single"
                                                      SelectionUnit="FullRow"
                                                      AlternatingRowBackground="#F8FBFF"
                                                      RowBackground="White">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Parameter" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="180" />
                                                    <DataGridTextColumn Header="Override value" Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                                                <Button Height="34" Content="Add override" Command="{Binding AddActiveControlFileParameterOverrideCommand}" />
                                                <Button Height="34" Margin="0,10,0,0" Content="Remove" Command="{Binding RemoveActiveControlFileParameterOverrideCommand}" CommandParameter="{Binding SelectedActiveControlFileParameterOverride}" />
                                            </StackPanel>

                                            <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0" Padding="12" Background="#F8FAFC" CornerRadius="8" BorderBrush="#DCE3E8" BorderThickness="1">
                                                <TextBlock Text="{Binding ControlFileStepPreviewStatus}" TextWrapping="Wrap" />
                                            </Border>

                                            <TextBox Grid.Row="3"
                                                     Grid.ColumnSpan="2"
                                                     Margin="0,14,0,0"
                                                     Padding="10"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     TextWrapping="NoWrap"
                                                     FontFamily="Consolas"
                                                     Text="{Binding ControlFileStepPreview}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Logging">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <Border Padding="14" Background="#EEF6FF" CornerRadius="10" BorderBrush="#B8D4F0" BorderThickness="1">
                                <TextBlock Foreground="#123A5A"
                                           TextWrapping="Wrap"
                                           Text="Configure the log file location, verbosity level, and how many rotated files to retain. Logging changes take effect after restarting the application." />
                            </Border>

                            <Border Margin="0,10,0,0" Padding="12" Background="#FFFBF0" CornerRadius="10" BorderBrush="#F0D080" BorderThickness="1">
                                <TextBlock Foreground="#5A3E00"
                                           TextWrapping="Wrap"
                                           Text="Instruction: if logs show Siemens.Engineering.Contract v19 load errors (MissingMethodException), switch to matching TIA runtime/provider in the TIA tab and re-run communication check." />
                            </Border>

                            <Border Margin="0,14,0,0" Padding="14" Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCE3E8" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.ColumnSpan="3" Text="Logging configuration" FontSize="20" FontWeight="Bold" Foreground="#0D1B2A" />

                                    <TextBlock Grid.Row="1" Margin="0,12,0,0" Text="Log directory" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,12,10,0" Padding="8" Text="{Binding LogDirectory}" />
                                    <Button Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" Width="90" Content="Browse" Command="{Binding BrowseLogDirectoryCommand}" />

                                    <TextBlock Grid.Row="2" Margin="0,12,0,0" Text="Minimum level" FontWeight="SemiBold" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,12,10,0" Padding="8" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogMinimumLevel}" />

                                    <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="Retained file count" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,12,10,0" Padding="8" Text="{Binding LogRetentionFileCount}" />

                                    <Button Grid.Row="4" Grid.ColumnSpan="3" Margin="0,16,0,0" Height="38" Content="Open log folder" Command="{Binding OpenLogDirectoryCommand}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Settings Exchange">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <Border Padding="14" Background="#EEF6FF" CornerRadius="10" BorderBrush="#B8D4F0" BorderThickness="1">
                                <TextBlock Foreground="#123A5A"
                                           TextWrapping="Wrap"
                                           Text="Export protected settings to a JSON file for backup or migration, or import a previously exported JSON file to restore configuration." />
                            </Border>

                            <Border Margin="0,10,0,0" Padding="12" Background="#FFFBF0" CornerRadius="10" BorderBrush="#F0D080" BorderThickness="1">
                                <TextBlock Foreground="#5A3E00"
                                           TextWrapping="Wrap"
                                           Text="Instruction: if logs show Siemens.Engineering.Contract v19 load errors (MissingMethodException), switch to matching TIA runtime/provider in the TIA tab and re-run communication check." />
                            </Border>

                            <Border Margin="0,14,0,0" Padding="14" Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCE3E8" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.ColumnSpan="4" Text="Settings exchange" FontSize="20" FontWeight="Bold" Foreground="#0D1B2A" />

                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="0,16,0,0" Text="Import / Export" FontWeight="SemiBold" />

                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Margin="0,16,16,0"
                                               VerticalAlignment="Center"
                                               Foreground="#5B6A72"
                                               Text="Export current configuration to JSON or import JSON back into the protected settings store." />

                                    <Button Grid.Row="1" Grid.Column="2"
                                            Width="120"
                                            Height="34"
                                            Margin="0,16,10,0"
                                            Content="Export"
                                            Command="{Binding ExportSettingsCommand}" />

                                    <Button Grid.Row="1" Grid.Column="3"
                                            Width="120"
                                            Height="34"
                                            Margin="0,16,0,0"
                                            Content="Import"
                                            Command="{Binding ImportSettingsCommand}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Session">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <Border Padding="14" Background="#EEF6FF" CornerRadius="10" BorderBrush="#B8D4F0" BorderThickness="1">
                                <TextBlock Foreground="#123A5A"
                                           TextWrapping="Wrap"
                                           Text="Manage the active session, monitor timeout, and view protected settings file location." />
                            </Border>

                            <Border Margin="0,10,0,0" Padding="12" Background="#FFFBF0" CornerRadius="10" BorderBrush="#F0D080" BorderThickness="1">
                                <TextBlock Foreground="#5A3E00"
                                           TextWrapping="Wrap"
                                           Text="Instruction: if logs show Siemens.Engineering.Contract v19 load errors (MissingMethodException), switch to matching TIA runtime/provider in the TIA tab and re-run communication check." />
                            </Border>

                            <Border Margin="0,14,0,0" Padding="14" Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCE3E8" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.ColumnSpan="4" Text="Session and application info" FontSize="20" FontWeight="Bold" Foreground="#0D1B2A" />

                                    <TextBlock Grid.Row="1" Margin="0,12,0,0" Text="Host name" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Text="{Binding HostName}" />

                                    <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="Protected settings file" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Text="{Binding SettingsFilePath}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="Session timeout" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,10,16,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding SessionTimeRemaining}" />
                                    <Button Grid.Row="3" Grid.Column="2" Margin="0,10,10,0" Width="110" Height="34" Content="Reset timer" Command="{Binding ResetSessionTimerCommand}" />
                                    <Button Grid.Row="3" Grid.Column="3" Margin="0,10,0,0" Width="90" Height="34" Content="Log out" Command="{Binding LogoutSessionCommand}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="140"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Apply settings"
                    Background="#1B4965"
                    Foreground="White"
                    BorderBrush="#1B4965"
                    Command="{Binding ApplySettingsCommand}" />
            <Button Width="120"
                    Height="36"
                    Content="Close"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
