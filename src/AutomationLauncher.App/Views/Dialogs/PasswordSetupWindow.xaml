<Window x:Class="AutomationLauncher.App.PasswordSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automation Launcher - First Login"
    Width="560"
    SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#F4F7F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Create configuration password"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#0D1B2A" />

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="14"
                CornerRadius="10"
                Background="#E6EEF2">
            <TextBlock TextWrapping="Wrap" Foreground="#33414A">
                This is the first application login. The password protects all settings and will be required on every startup.&#10;&#10;Minimum requirements: at least 12 characters, one uppercase letter, one lowercase letter, one digit and one special character.
            </TextBlock>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,18,0,0"
                   Text="Password"
                   FontWeight="SemiBold" />
        <PasswordBox x:Name="PasswordBox"
                     Grid.Row="3"
                     Margin="0,8,0,0"
                     Padding="10"
                     FontSize="16" />

        <TextBlock Grid.Row="4"
                   Margin="0,14,0,0"
                   Text="Confirm password"
                   FontWeight="SemiBold" />
        <PasswordBox x:Name="ConfirmPasswordBox"
                     Grid.Row="5"
                     Margin="0,8,0,0"
                     Padding="10"
                     FontSize="16"
                     Height="42"
                     VerticalAlignment="Top" />

        <Grid Grid.Row="6" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ValidationMessage"
                       VerticalAlignment="Center"
                       Foreground="#A63D40"
                       TextWrapping="Wrap" />

            <Button Grid.Column="1"
                    Width="150"
                    Height="36"
                    Content="Save password"
                    Background="#1B4965"
                    Foreground="White"
                    BorderBrush="#1B4965"
                    Click="SavePassword_Click" />
        </Grid>
    </Grid>
</Window>