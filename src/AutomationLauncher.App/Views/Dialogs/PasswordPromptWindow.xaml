<Window x:Class="AutomationLauncher.App.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automation Launcher - Unlock Configuration"
        Width="460"
    SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#F4F7F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Unlock protected configuration"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#0D1B2A" />

        <TextBlock Grid.Row="1"
                   Margin="0,10,0,0"
                   Text="Enter the password configured during the first launch. Without it, the application will not load protected settings."
                   TextWrapping="Wrap"
                   Foreground="#44525A" />

                <Grid Grid.Row="2"
                            Margin="0,18,0,0">
                        <PasswordBox x:Name="PasswordBox"
                                                 Padding="10"
                                                 FontSize="16"
                                                 Height="42"
                                                 KeyDown="PasswordInput_KeyDown" />

                        <TextBox x:Name="PasswordTextBox"
                                         Padding="10"
                                         FontSize="16"
                                         Height="42"
                                         Visibility="Collapsed"
                                         KeyDown="PasswordInput_KeyDown" />
                </Grid>

        <CheckBox x:Name="ShowPasswordToggle"
                  Grid.Row="3"
                  Margin="0,10,0,0"
                  HorizontalAlignment="Left"
                  Content="Show password"
                  Foreground="#44525A"
                  Checked="ShowPasswordToggle_Checked"
                  Unchecked="ShowPasswordToggle_Unchecked" />

        <TextBlock x:Name="ValidationMessage"
                                     Grid.Row="4"
                   Margin="0,12,0,0"
                   Foreground="#A63D40"
                   TextWrapping="Wrap" />

                <StackPanel Grid.Row="5"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="92"
                    Height="34"
                    Margin="0,0,10,0"
                    Content="Cancel"
                    Click="Cancel_Click" />
            <Button Width="110"
                    Height="34"
                    Content="Unlock"
                    Background="#1B4965"
                    Foreground="White"
                    BorderBrush="#1B4965"
                    IsDefault="True"
                    Click="Unlock_Click" />
        </StackPanel>
    </Grid>
</Window>