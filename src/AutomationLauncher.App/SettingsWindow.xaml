<Window x:Class="AutomationLauncher.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automation Launcher - Settings"
        Width="860"
    Height="980"
        MinWidth="760"
    MinHeight="780"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F7F8">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="18" Background="#0D1B2A" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="Protected Settings"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#D8E2EA"
                               Text="All configuration is loaded from an encrypted store unlocked with the session password." />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#BFD4E2"
                               FontWeight="SemiBold"
                               Text="{Binding AppVersion, StringFormat=Version {0}}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Margin="0,16,0,0" Padding="16" Background="White" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Host name" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding HostName}" />

                    <TextBlock Grid.Row="1" Margin="0,10,0,0" Text="Application version" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Text="{Binding AppVersion}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="Protected settings file" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Text="{Binding SettingsFilePath}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="Status" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Text="{Binding SettingsStatusMessage}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="4" Margin="0,14,0,0" Text="Time until auto logout" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,14,16,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding SessionTimeRemaining}" />
                    <Button Grid.Row="4" Grid.Column="2" Margin="0,14,10,0" Width="110" Height="34" Content="Reset timer" Command="{Binding ResetSessionTimerCommand}" />
                    <Button Grid.Row="4" Grid.Column="3" Margin="0,14,0,0" Width="90" Height="34" Content="Log out" Command="{Binding LogoutSessionCommand}" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,16,0,0" Padding="16" Background="White" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Project path" FontWeight="SemiBold" />
                    <TextBox Grid.Column="1" Margin="0,0,10,0" Padding="8" Text="{Binding ExpectedProjectPath}" />
                    <Button Grid.Column="2" Width="90" Content="Browse" Command="{Binding BrowseProjectFileCommand}" />

                    <TextBlock Grid.Row="1" Margin="0,12,0,0" Text="Archive directory" FontWeight="SemiBold" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,12,10,0" Padding="8" Text="{Binding ArchiveOutputDirectory}" />
                    <Button Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" Width="90" Content="Browse" Command="{Binding BrowseArchiveDirectoryCommand}" />

                    <TextBlock Grid.Row="2" Margin="0,16,0,0" Text="TIA selection mode" FontWeight="SemiBold" />
                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,16,10,0"
                              Padding="8"
                              ItemsSource="{Binding TiaRuntimeSelectionModes}"
                              SelectedItem="{Binding TiaRuntimeSelectionMode}" />

                    <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="Preferred TIA runtime" FontWeight="SemiBold" />
                    <ComboBox Grid.Row="3"
                              Grid.Column="1"
                              Margin="0,12,10,0"
                              Padding="8"
                              ItemsSource="{Binding AvailableTiaRuntimes}"
                              SelectedItem="{Binding SelectedTiaRuntime}" />

                    <Button Grid.Row="4"
                            Grid.ColumnSpan="3"
                            Margin="0,16,0,0"
                            Height="38"
                            Content="Check communication with TIA Portal"
                            Background="#1A6B3A"
                            Foreground="White"
                            BorderBrush="#1A6B3A"
                            Command="{Binding CheckTiaConnectionCommand}" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Margin="0,16,0,0" Padding="16" Background="White" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Launch on Windows startup" FontWeight="SemiBold" />
                    <CheckBox Grid.Column="1"
                              VerticalAlignment="Center"
                              IsChecked="{Binding LaunchOnWindowsStartup}"
                              Content="Create application startup entry" />

                    <TextBlock Grid.Row="1" Margin="0,16,0,0" Text="Startup folder" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,16,10,0" Text="{Binding StartupFolderPath}" TextWrapping="Wrap" />
                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,16,0,0"
                            Width="140"
                            Content="Open folder"
                            Command="{Binding OpenStartupFolderCommand}" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Margin="0,16,0,0" Padding="16" Background="White" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="3"
                               Text="Windows startup automation"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0D1B2A" />

                    <CheckBox Grid.Row="1"
                              Grid.ColumnSpan="3"
                              Margin="0,12,0,0"
                              IsChecked="{Binding RunStartupSequenceOnWindowsStartup}"
                              Content="Run the startup sequence automatically when the application starts from Windows autostart" />

                    <TextBlock Grid.Row="2" Margin="0,16,0,0" Text="Splash background image" FontWeight="SemiBold" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,16,10,0" Padding="8" Text="{Binding StartupSplashBackgroundImagePath}" />
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,16,0,0" Orientation="Horizontal">
                        <Button Width="90" Content="Browse" Command="{Binding BrowseStartupSplashBackgroundCommand}" />
                        <Button Width="70" Margin="10,0,0,0" Content="Clear" Command="{Binding ClearStartupSplashBackgroundCommand}" />
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               Grid.ColumnSpan="3"
                               Margin="0,12,0,0"
                               Foreground="#2F4456"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="The splash screen stays on top, shows the current startup action, supports a custom background image, and allows the user to cancel the sequence." />

                    <Grid Grid.Row="4" Grid.ColumnSpan="3" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <DataGrid Grid.Column="0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  Height="240"
                                  ItemsSource="{Binding StartupSequenceEntries}"
                                  SelectedItem="{Binding SelectedStartupSequenceEntry}"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Alias"
                                                    Binding="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="200" />
                                <DataGridTextColumn Header="Application path"
                                                    Binding="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Delay (s)"
                                                    Binding="{Binding DelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <Button Height="34" Content="Add app" Command="{Binding AddStartupSequenceEntryCommand}" />
                            <Button Height="34" Margin="0,10,0,0" Content="Remove" Command="{Binding RemoveSelectedStartupSequenceEntryCommand}" />
                            <Button Height="34" Margin="0,10,0,0" Content="Move up" Command="{Binding MoveStartupSequenceEntryUpCommand}" />
                            <Button Height="34" Margin="0,10,0,0" Content="Move down" Command="{Binding MoveStartupSequenceEntryDownCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="5" Margin="0,16,0,0" Padding="16" Background="White" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Log directory" FontWeight="SemiBold" />
                    <TextBox Grid.Column="1" Margin="0,0,10,0" Padding="8" Text="{Binding LogDirectory}" />
                    <Button Grid.Column="2" Width="90" Content="Browse" Command="{Binding BrowseLogDirectoryCommand}" />

                    <TextBlock Grid.Row="1" Margin="0,12,0,0" Text="Minimum level" FontWeight="SemiBold" />
                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,12,10,0"
                              Padding="8"
                              ItemsSource="{Binding LogLevels}"
                              SelectedItem="{Binding LogMinimumLevel}" />

                    <TextBlock Grid.Row="2" Margin="0,12,0,0" Text="Retained file count" FontWeight="SemiBold" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,12,10,0" Padding="8" Text="{Binding LogRetentionFileCount}" />

                    <Button Grid.Row="3"
                            Grid.ColumnSpan="3"
                            Margin="0,16,0,0"
                            Height="38"
                            Content="Open log folder"
                            Command="{Binding OpenLogDirectoryCommand}" />
                </Grid>
            </Border>

                    <StackPanel Grid.Row="7"
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="140"
                        Height="36"
                        Margin="0,0,10,0"
                        Content="Apply settings"
                        Background="#1B4965"
                        Foreground="White"
                        BorderBrush="#1B4965"
                        Command="{Binding ApplySettingsCommand}" />
                <Button Width="120"
                        Height="36"
                        Content="Close"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>