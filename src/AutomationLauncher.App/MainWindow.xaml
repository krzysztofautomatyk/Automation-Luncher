<Window x:Class="AutomationLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Automation Launcher - Tray Dashboard"
        Width="960"
        Height="720"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#F4F7F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#E2EAF0" />
            <Setter Property="Foreground" Value="#0D1B2A" />
            <Setter Property="BorderBrush" Value="#C5D3DE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D3E1EC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C0D3E0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1F567D" />
            <Setter Property="BorderBrush" Value="#1F567D" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="PositiveActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1E7D4C" />
            <Setter Property="BorderBrush" Value="#1E7D4C" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="DangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B23B3B" />
            <Setter Property="BorderBrush" Value="#B23B3B" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="560" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="460" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="3" Padding="18" Background="#0D1B2A" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="Automation Launcher" Foreground="White" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="The application works primarily from the tray icon. Use this dashboard for status, diagnostics and manual actions."
                           Foreground="#D8E2EA"
                           Margin="0,8,0,0" />
                <TextBlock Text="{Binding AppVersion, StringFormat=Version {0}}"
                           Foreground="#BFD4E2"
                           Margin="0,8,0,0"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Margin="0,16,0,0" Padding="16" Background="White" CornerRadius="12">
            <StackPanel>
                <UniformGrid Columns="4">
                    <Button Margin="0,0,12,0"
                            Height="38"
                            Content="Settings"
                            Click="Settings_Click" />

                    <Button Margin="0,0,12,0"
                            Height="38"
                            Content="About"
                            Click="About_Click" />

                    <Button Height="38"
                            Margin="0,0,12,0"
                            Content="Check TIA connection"
                            Style="{StaticResource PositiveActionButtonStyle}"
                            IsEnabled="{Binding CanUseProtectedActions}"
                            Command="{Binding CheckTiaConnectionCommand}" />

                    <Button Height="38"
                            Margin="0"
                            Content="Create archive now"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            IsEnabled="{Binding CanUseProtectedActions}"
                            Click="ArchiveNow_Click" />
                </UniformGrid>

                <TextBlock Margin="0,12,0,0"
                           Foreground="#5B6A72"
                           Text="Protected functions are enabled only after unlocking the session in Settings. Dashboard and tray actions stay in sync." />

                <UniformGrid Columns="4" Margin="0,12,0,0">
                    <Button Margin="0,0,12,0"
                            Height="34"
                            Content="Run startup automation now"
                            IsEnabled="{Binding CanRunStartupAutomationManually}"
                            Click="RunStartupAutomation_Click" />

                    <Button Margin="0,0,12,0"
                            Height="34"
                            Content="Run managed applications"
                            IsEnabled="{Binding CanRunStartupAutomationManually}"
                            Click="RunManagedApplications_Click" />

                    <Button Margin="0,0,12,0"
                            Height="34"
                            Content="Stop managed applications"
                            Style="{StaticResource DangerActionButtonStyle}"
                            IsEnabled="{Binding CanStopManagedApplications}"
                            Click="StopManagedApplications_Click" />

                    <Button Height="34"
                            Margin="0"
                            Content="Open autostart folder"
                            IsEnabled="{Binding CanUseProtectedUtilities}"
                            Command="{Binding OpenStartupFolderCommand}" />
                </UniformGrid>

                <UniformGrid Columns="5" Margin="0,10,0,0">
                    <Button Margin="0,0,12,0"
                            Height="34"
                            Content="Open control files folder"
                            IsEnabled="{Binding CanUseProtectedUtilities}"
                            Command="{Binding OpenControlFilesFolderCommand}" />

                    <Button Margin="0,0,12,0"
                            Height="34"
                            Content="Open log folder"
                            IsEnabled="{Binding CanUseProtectedUtilities}"
                            Command="{Binding OpenLogDirectoryCommand}" />

                    <Button Margin="0,0,12,0"
                            Height="34"
                            Content="Delete error"
                            Style="{StaticResource DangerActionButtonStyle}"
                            IsEnabled="{Binding HasErrorControlFile}"
                            Click="DeleteError_Click" />

                        <Button Margin="0,0,12,0"
                            Height="34"
                            Content="Log in"
                            Style="{StaticResource PositiveActionButtonStyle}"
                            IsEnabled="{Binding CanLoginSession}"
                            Click="Login_Click" />

                    <Button Height="34"
                            Margin="0"
                            Content="Log out"
                            Style="{StaticResource DangerActionButtonStyle}"
                            IsEnabled="{Binding IsSessionAuthenticated}"
                            Command="{Binding LogoutSessionCommand}" />
                </UniformGrid>

                <Grid Margin="0,10,0,0">
                    <Button Width="120"
                            HorizontalAlignment="Right"
                            Margin="0"
                            Content="Exit"
                            Click="Exit_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Margin="0,16,0,0" Padding="16" Background="White" CornerRadius="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Runtime status" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Margin="0,10,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,10,0,0" Foreground="#5B6A72" Text="{Binding RuntimeDecisionMessage}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,10,0,0" Foreground="#5B6A72" Text="{Binding SettingsStatusMessage}" TextWrapping="Wrap" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" MinWidth="360" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Host name" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding HostName}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Text="Application version" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding AppVersion}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Text="Configured project path" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="{Binding ExpectedProjectPath}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3" Text="Archive directory" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Text="{Binding ArchiveOutputDirectory}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="4" Text="Detected process version" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Text="{Binding DetectedProcessVersion}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="5" Text="Selected runtime" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Text="{Binding SelectedRuntimeVersion}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="6" Text="Selected provider" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" Text="{Binding SelectedProviderName}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="7" Text="Assembly path" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,8,0,0" Text="{Binding SelectedAssemblyPath}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="8" Text="Host control state" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Margin="0,8,0,0" Text="{Binding HostControlStateDisplay}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="9" Text="Control files folder" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Margin="0,8,0,0" Text="{Binding ControlFilesFolderPath}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="10" Text="Run file" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="10" Grid.Column="1" Margin="0,8,0,0" Text="{Binding HostRunFilePath}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="11" Text="Ready file" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="11" Grid.Column="1" Margin="0,8,0,0" Text="{Binding HostReadyFilePath}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="12" Text="Error file" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="12" Grid.Column="1" Margin="0,8,0,0" Text="{Binding HostErrorFilePath}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="13" Text="Start file" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="13" Grid.Column="1" Margin="0,8,0,0" Text="{Binding HostStartFilePath}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="14" Text="Stop file" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="14" Grid.Column="1" Margin="0,8,0,0" Text="{Binding HostStopFilePath}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="15" Text="March file" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="15" Grid.Column="1" Margin="0,8,0,0" Text="{Binding HostMarchFilePath}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="16" Text="Archok file" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="16" Grid.Column="1" Margin="0,8,0,0" Text="{Binding HostArchOkFilePath}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Row="1"
                      Grid.Column="1"
                      Grid.RowSpan="3"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      Background="#D0D7DE" />

        <Border Grid.Row="1" Grid.Column="2" Grid.RowSpan="3" Margin="0,16,0,0" Padding="16" Background="White" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Logs"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="#5B6A72"
                               FontWeight="SemiBold"
                               Text="{Binding VisibleLogCount, StringFormat=Visible: {0}}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Height="32"
                             Margin="0,0,10,0"
                             VerticalContentAlignment="Center"
                             FontSize="13"
                             Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="1"
                            Height="32"
                            Margin="0,0,10,0"
                            Padding="10,4"
                            Content="Clear"
                            IsEnabled="{Binding HasLogSearchText}"
                            Command="{Binding ClearLogSearchCommand}" />

                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="#5B6A72"
                               Text="Search logs" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Content="Only ERR/WRN"
                              VerticalAlignment="Center"
                              IsChecked="{Binding ShowErrorsAndWarningsOnly}" />

                    <CheckBox Grid.Column="1"
                              Content="Auto-scroll"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsLogAutoScrollEnabled}" />
                </Grid>

                <ListBox x:Name="LogsListBox"
                         Grid.Row="3"
                         Margin="0,12,0,8"
                         ItemsSource="{Binding FileLogs}"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.IsDeferredScrollingEnabled="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4"
                                    Padding="6,4"
                                    CornerRadius="6"
                                    Background="{Binding Background}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Level}"
                                               FontWeight="Bold"
                                               Foreground="{Binding Foreground}" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Message}"
                                               Foreground="{Binding Foreground}"
                                               TextWrapping="Wrap"
                                               FontFamily="Consolas" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="4"
                           Foreground="#5B6A72"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="11"
                           Text="{Binding LoadedLogFilePath, StringFormat=Loaded file: {0}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Grid.Column="0" Margin="0,14,0,0">
            <TextBlock Text="The main window stays outside the taskbar. Use the tray icon next to the clock for quick actions and settings."
                       Foreground="#5B6A72"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
